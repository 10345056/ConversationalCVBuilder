{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "CvBuilder": "Data Source=conversational-cv-builder.db;Cache=Shared"
  },
  "Copilot": {
    "Model": "auto",
    "TimeoutSeconds": 90
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434/",
    "Model": "llama3.1",
    "Temperature": 0.2,
    "TimeoutSeconds": 120
  },
  "Whisper": {
    "BaseUrl": "http://localhost:9000/",
    "TranscriptionsPath": "v1/audio/transcriptions",
    "Model": "whisper-1",
    "Language": "en",
    "TimeoutSeconds": 120,
    "MaximumAudioBytes": 26214400
  },
  "AllowedHosts": "*"
}
